<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local source for pre-release WinMcp.ModuleSdk packages during
         development. Once the SDK is published to nuget.org, this entry
         becomes redundant but harmless. -->
    <add key="local" value="./local-packages" />
  </packageSources>
</configuration>
